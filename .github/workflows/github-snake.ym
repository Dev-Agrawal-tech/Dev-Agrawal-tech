name: Generate Contribution Snake

on:
  schedule:
    # Runs once a day at 00:17 UTC
    - cron: "17 0 * * *"
  workflow_dispatch: {}
  push:
    branches:
      - main

permissions:
  contents: write

jobs:
  generate-snake:
    runs-on: ubuntu-latest
    steps:
      - name: Generate the pink/purple contribution snake
        uses: Platane/snk@v3
        id: snake-gif
        with:
          github_user_name: ${{ github.repository_owner }}
          outputs: |
            dist/github-snake.svg?color_snake=%23ff4fd8&color_dots=%231c0f33,%234a2170,%237c3aed,%23c026d3,%23ff4fd8
            dist/github-snake-dark.svg?color_snake=%23c084fc&color_dots=%231a0b2e,%234a2170,%237c3aed,%23c026d3,%23ff4fd8&color_snake_dot_border=%23ffffff
            dist/github-snake.gif?color_snake=%23ff4fd8&color_dots=%231c0f33,%234a2170,%237c3aed,%23c026d3,%23ff4fd8

      - name: Push snake output to the "output" branch
        uses: crazy-max/ghaction-github-pages@v4
        with:
          target_branch: output
          build_dir: dist
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
